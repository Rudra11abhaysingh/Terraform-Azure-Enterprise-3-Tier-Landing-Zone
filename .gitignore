# Local .terraform directories (Plugins and modules)
**/.terraform/*

# Terraform State files (Contains infrastructure details and plain-text secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files (Often contain sensitive Azure credentials)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc